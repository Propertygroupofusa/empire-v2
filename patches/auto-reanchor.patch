+def auto_reanchor_enabled() -> bool:
+    """Whether a FLAT branch's reference follows the market. ON unless off.
+
+    Defaults ON because the alternative is a self-tightening trap: a branch
+    that has not filled drifts further from ever filling, and the only cure
+    was a human noticing a dashboard card and pressing a button. Set
+    GRID_AUTO_REANCHOR=false to go back to manual.
+    """
+    raw = (os.getenv("GRID_AUTO_REANCHOR") or "").strip().strip('"').strip("'").lower()
+    return raw not in {"0", "false", "no", "off"}
