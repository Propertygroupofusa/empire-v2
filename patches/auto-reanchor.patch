+# ---- Auto re-anchor: a FLAT branch's reference follows the market ----
+#
+# reference_price is written exactly twice: when a branch is created, and
+# thereafter only on a real fill. Nothing moves it toward the market. So a
+# flat branch that has not traded through a rally measures its next buy from
+# a level the market already left - and because no fill means no re-anchor,
+# a rising market makes the next fill HARDER, not easier. Self-tightening.
+#
+# Measured live on 2026-09-25 at a 2.50% step: six flat branches were
+# waiting on falls of 2.89% to 4.80%. ARB needed 4.80%, nearly twice its
+# own spacing.
+#
+# Two throttles, because the naive version ("re-anchor whenever price is
+# above reference") fires every cycle - ~37s - for every flat branch, and
+# commits a database write for a fraction of a basis point:
+#
+#   DRIFT    ignore anything smaller than this. Every case that actually
+#            stranded a branch was 2.89%+, so 0.50% catches all of them
+#            and none of the noise.
+#   SECONDS  and never more than once per branch inside this window, so a
+#            coin ticking either side of the threshold cannot write in a
+#            loop.
+#
+# Together these turn ~580 writes/hour into a handful, same recovery.
+REANCHOR_MIN_DRIFT_PCT = float(os.getenv("GRID_REANCHOR_MIN_DRIFT_PCT", "0.005"))
+REANCHOR_MIN_SECONDS = float(os.getenv("GRID_REANCHOR_MIN_SECONDS", "60"))
+
+# bot_name -> time.monotonic() of that branch's last re-anchor. Deliberately
+# in memory: after a restart every branch is eligible again, which is
+# exactly what a restart should do, and it needs no migration.
+_LAST_REANCHOR_AT = {}
+
+
+def auto_reanchor_enabled() -> bool:
+    """Whether a FLAT branch's reference follows the market. ON unless off.
+
+    Defaults ON because the alternative is the self-tightening trap above:
+    a branch that has not filled drifts further from ever filling, and the
+    only cure was a human noticing a dashboard card and pressing a button.
+    A button is a one-shot - references go stale the moment prices move.
+    Set GRID_AUTO_REANCHOR=false to go back to manual.
+    """
+    raw = (os.getenv("GRID_AUTO_REANCHOR") or "").strip().strip('"').strip("'").lower()
+    return raw not in {"0", "false", "no", "off"}
+
