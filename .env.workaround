# Network Access Workaround for Railway Egress Blocking
# Use this to enable fallback/cache mode while waiting for Railway egress whitelist configuration

# Retry Configuration
NETWORK_RETRY_ATTEMPTS=5
NETWORK_CACHE_TTL=600

# Bot Fallback Modes
CRYPTO_BOT_SKIP_ENTRIES_ON_API_FAILURE=true
ALPACA_BOT_SKIP_ENTRIES_ON_API_FAILURE=true

# Price/Balance Fallback Behavior
FALLBACK_BALANCE_MODE=cached
FALLBACK_PRICE_MODE=skip

# Logging
NETWORK_LOG_LEVEL=INFO

# Keep these for Stripe payment processing (video orders still work)
# These should be set in Railway dashboard:
# STRIPE_SECRET_KEY=sk_...
# STRIPE_PUBLISHABLE_KEY=pk_...
# STRIPE_WEBHOOK_SECRET=whsec_...
