.env
# `.env` alone is an EXACT filename match - it never covered
# .env.workaround or .env.railway.workaround, both of which a prior
# session committed in Aug 2026 while building a Railway egress
# workaround. This pattern covers every .env* variant. Example files
# are named *.env.example (e.g. .railway.env.example) and do not
# start with `.env`, so they stay tracked.
.env*
__pycache__/
*.pyc
*.log
*.json
.DS_Store 
# Video editor directories (temp processing files)
video_uploads/
video_temp/
video_exports/
# Video editor frontend
video-editor/node_modules/
video-editor/build/
video-editor/dist/
empire.db

# Collected market data - regenerable, can grow large, not source
kalshi_polymarket_data.jsonl
.money_truth_snapshot.json

# Written by run_tests.sh on every run - the failing list from the last run,
# read by CI to surface it as an annotation. Never a committed fact; the
# committed one is test_baseline.txt.
test_failures_last_run.txt
.deploy_watch_baseline.json
