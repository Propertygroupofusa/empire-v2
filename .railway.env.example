# Empire Video Production System - Railway Environment Variables
# Copy these to your Railway project Variables tab and fill in the values

# ===== EXISTING VARIABLES (keep these) =====
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_LIVE_TRADE=false

ANTHROPIC_API_KEY=sk-ant-your_key_here
OPENAI_API_KEY=sk-your_openai_key_here
GROK_API_KEY=your_xai_key_here

SYNTHESIA_API_KEY=your_synthesia_key_here
SYNTHESIA_WEBHOOK_SECRET=your_synthesia_webhook_secret_here

YOUTUBE_API_KEY=your_youtube_key_here
YOUTUBE_CLIENT_ID=your_client_id_here
YOUTUBE_CLIENT_SECRET=your_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_refresh_token_here

STOP_TRADING=false
# Alpaca's own off switch (alpaca_stop.py). Unset: Alpaca follows STOP_TRADING.
# Set true or false to stop or run Alpaca without touching Coinbase.
# ALPACA_STOP_TRADING=
# One-time XLM/XRP book correction (book_fix.py). yes runs it once at boot;
# it writes slice rows on those two branches only. Remove it afterwards.
# BOOK_FIX_XLM_XRP=
# Coin picker buy rule (coin_picker.py). btc50: buy only while BTC is above
# a rising 50-day average, and sell new pieces at 5% after fees. Unset: as built.
# Buys nothing while GRID_COIN_PICKER=sell.
# GRID_COIN_PICKER_RULE=
# The patient stock bot (alpaca_patient.py), Alpaca only. paper: practice -
# reads Alpaca's hourly prices and records what it would buy and sell, no
# orders. live (alpaca_patient_live.py): real DAY LIMIT orders on the same
# rule, never a sale under the target, only while Alpaca's off switch keeps
# the old stock bots stopped. Anything else is off.
# ALPACA_PATIENT=
EMPIRE_ACCOUNT_SIZE=100000
EMPIRE_HARD_STOP=80000
EMPIRE_REDUCE_AT=90000
PROP_PROFIT_TARGET=1500
PROP_DAILY_LOSS_LIMIT=1000
HEALTH_CHECK_INTERVAL=60
PORT=10000

# ===== NEW: VIDEO PRODUCTION SYSTEM VARIABLES =====

# Video Generator Configuration
VIDEO_GENERATOR_PORT=5003
VIDEO_GENERATOR_ENABLED=true

# Video Editor Configuration
VIDEO_EDITOR_PORT=5001
VIDEO_EDITOR_API_URL=http://localhost:5001

# Auto-Editor Configuration
VIDEO_AUTO_EDITOR_PORT=5002
VIDEO_AUTO_EDITOR_URL=http://localhost:5002

# Maximum video file size (500MB)
MAX_VIDEO_SIZE=500000000

# Storage paths (Railway uses ephemeral storage)
TEMP_STORAGE=/tmp/video-editor
EXPORT_STORAGE=/tmp/video-exports

# FFmpeg path (pre-installed in Docker)
FFMPEG_PATH=ffmpeg

# edge-tts (AI voice) configuration
EDGE_TTS_ENABLED=true

# ── YOUTUBE SCHEDULER ────────────────────────────────────────────────────
# The loop that posts on its own. OFF unless this is EXACTLY "arm" - not
# "1", not "true", not "on". Arming it is NOT permission to post to any
# given channel: each channel carries its own publishing_enabled (default
# off) and its own daily_upload_limit (unset means no automatic uploads).
# Privacy defaults to private; a channel has to ask for anything else.
# YOUTUBE_SCHEDULER=arm
YOUTUBE_SCHEDULER_SECONDS=900

# YouTube auto-publish settings
# NOTE: YOUTUBE_AUTO_PUBLISH is read ONLY by daily_publisher.py, which is a
# SEPARATE path from the scheduler above and is itself gated on
# DAILY_PUBLISHER_ENABLED. It POSTs to /publish/youtube/* without naming a
# channel, so none of the scheduler's gates apply to it. Turning that on and
# this scheduler on at once is two publishers under two sets of rules.
# YOUTUBE_DEFAULT_PRIVACY is read by nothing at all.
YOUTUBE_AUTO_PUBLISH=true
YOUTUBE_DEFAULT_PRIVACY=unlisted

# Video quality defaults
VIDEO_DEFAULT_QUALITY=1080p
VIDEO_EXPORT_FORMAT=mp4

# Performance tuning
VIDEO_PROCESSING_TIMEOUT=300
VIDEO_ENCODING_THREADS=4
VIDEO_CLEANUP_INTERVAL=3600
