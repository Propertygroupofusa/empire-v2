# Railway Network Egress Workaround Configuration
#
# Use this when Railway blocks direct access to broker APIs (HTTP 403 errors).
# Set these in Railway dashboard → environment variables
#
# Two options:
# A) REQUEST EGRESS WHITELIST (recommended, permanent fix):
#    - Go to Railway dashboard Settings → Network
#    - Add api.coinbase.com, api.alpaca.markets to allowlist
#    - Redeploy
#
# B) USE WORKAROUND CONFIGURATION (below, temporary):
#    - Set these env vars in Railway
#    - Bot will use retry logic + caching
#    - Monitor logs for fallback data usage

# ============================================================================
# NETWORK ACCESS CONFIGURATION
# ============================================================================

# Comma-separated list of hosts that are already whitelisted
# (Used by bot to skip retry logic for known-unavailable hosts)
# ALLOWED_EGRESS_HOSTS=stripe.com

# Number of retry attempts when API calls fail (connection errors only)
# 403 errors are not retried (won't change mid-session)
# Default: 3
NETWORK_RETRY_ATTEMPTS=5

# How long to cache API responses (seconds)
# Reduces repeated calls during network issues
# Default: 300 (5 minutes)
NETWORK_CACHE_TTL=600

# ============================================================================
# TRADER-SPECIFIC OVERRIDES
# ============================================================================

# If Coinbase API is completely unavailable for extended time, skip entries:
# "true" = bot continues but doesn't enter new positions (runs exits only)
# "false" = bot attempts entries despite API unavailability (risky)
CRYPTO_BOT_SKIP_ENTRIES_ON_API_FAILURE=true

# If Alpaca API is unavailable:
ALPACA_BOT_SKIP_ENTRIES_ON_API_FAILURE=true

# ============================================================================
# FALLBACK DATA BEHAVIOR
# ============================================================================

# When broker balance API fails:
# "real" = bot halts (requires real balance data)
# "cached" = bot uses last-known balance (from cache)
# "zero" = bot treats balance as $0 (safest, bot won't trade)
FALLBACK_BALANCE_MODE=cached

# When price feed fails:
# "skip" = bot skips that symbol this cycle (no entries)
# "cached" = bot uses last-known price (risky, price stale)
FALLBACK_PRICE_MODE=skip

# ============================================================================
# MONITORING & LOGGING
# ============================================================================

# Log level for network operations
# DEBUG = verbose (every retry attempt)
# INFO = normal
# WARNING = only problems
NETWORK_LOG_LEVEL=INFO

# Alert if API response is from cache (vs. fresh)
ALERT_ON_CACHE_HIT=false

# ============================================================================
# NEXT STEPS
# ============================================================================
#
# Step 1: Set these env vars in Railway dashboard
#
# Step 2: Redeploy the app (push to trigger)
#
# Step 3: Check logs:
#   tail -f /tmp/empire-server.log | grep -E "Network|CACHE|fallback"
#
# Step 4: Monitor bot behavior:
#   curl http://localhost:8000/crypto/analytics/health
#   (Should show instrumentation active even if API cached)
#
# Step 5: Once Railway adds egress whitelist, remove these env vars
#   (Bot will use real-time API responses instead)
#
# ============================================================================
