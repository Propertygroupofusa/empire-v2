FROM python:3.11-slim

# Install FFmpeg and other dependencies
RUN apt-get update && apt-get install -y \
    ffmpeg \
    gcc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the whole app, not just video_editor_api.py - this Dockerfile is
# shared by video-generator (video_generator_bot.py) and video-auto-editor
# (video_auto_editor.py) too, via their own startCommand overrides in
# railway.json. Copying a single file meant those two services' start
# commands pointed at a script that didn't exist in the built image at
# all - they'd fail immediately on deploy.
COPY . .

# Ensure start command scripts are executable. Railway checks execute
# permissions at container creation time (before the start command runs),
# so this must be baked into the image rather than handled at runtime.
RUN chmod +x video_generator_bot.py video_auto_editor.py video_editor_api.py run_server.sh

# Create directories
RUN mkdir -p video_uploads video_temp video_exports

# Ensure the scripts shared by video-generator and video-auto-editor
# (which override the start command via railway.json) are executable
RUN chmod +x video_generator_bot.py video_auto_editor.py video_editor_api.py

# Expose port
EXPOSE 5001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:5001/api/video/health')"

# Run API
CMD ["python", "video_editor_api.py"]
